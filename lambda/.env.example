# Reference only — Lambda does not auto-load .env files. These are set as
# real Lambda environment variables by template.yaml (SAM) at deploy time.
#
# The Firebase service account itself lives in AWS Secrets Manager, not in
# an env var — create the secret out-of-band and pass its ARN as the
# FirebaseSecretArn parameter when running `sam deploy`:
#
#   sam deploy --parameter-overrides \
#     FirebaseSecretArn=arn:aws:secretsmanager:us-east-1:123456789012:secret:halo/firebase-sa-XXXXXX
#
# Grant that service account only Firestore write access to the
# "recognitions" collection (least privilege), not full project admin.

AWS_REGION=us-east-1
FIREBASE_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:halo/firebase-sa-XXXXXX

# Toxicity score threshold (0-1). Any Comprehend toxicity label at or
# above this score causes the post to be rejected. 0.5 is a reasonable
# starting point — tune based on false-positive/negative rates.
TOXICITY_THRESHOLD=0.5
