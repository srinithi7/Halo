# Copy this file to functions/.env for local development
# (firebase-functions v2 loads .env automatically). Never commit the real
# .env file — it's already excluded in functions/.gitignore.
#
# For deployed functions, prefer setting these via:
#   firebase functions:secrets:set AWS_ACCESS_KEY_ID
#   firebase functions:secrets:set AWS_SECRET_ACCESS_KEY
# rather than relying on a plain .env file in production.

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/your-queue-name
